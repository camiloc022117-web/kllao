{
  "installCommand": "npm install && cd frontend && npm install",
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static",
      "config": {
        "buildCommand": "npm run build",
        "outputDirectory": "dist"
      }
    }
  ],
  "rewrites": [
    { "source": "/api/auth", "destination": "/api/auth.js" },
    { "source": "/api/categories", "destination": "/api/categories.js" },
    { "source": "/api/sizes", "destination": "/api/sizes.js" },
    { "source": "/api/products", "destination": "/api/products.js" },
    { "source": "/api/variants", "destination": "/api/variants.js" },
    { "source": "/api/sales", "destination": "/api/sales.js" },
    { "source": "/api/stock-entries", "destination": "/api/stock-entries.js" },
    { "source": "/((?!api/).*)", "destination": "/frontend/dist/$1" }
  ]
}
